# Copy to .env locally. Never commit real credentials or personal IDs.
# Runtime configuration is planned; this scaffold does not connect to Discord yet.
DISCORD_BOT_TOKEN=replace_me
# Required, comma-separated numeric Discord IDs; an empty list must fail closed.
DISCORD_ALLOWED_USER_IDS=
DISCORD_COMMAND_NAME=ask
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Download explicitly yourself; GoatLLM never pulls models automatically.
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=0
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=512
# false suits the example Qwen3 model. See docs/IMPLEMENTATION_PLAN.md.
OLLAMA_THINK=false
MAX_PROMPT_CHARS=1800
MAX_CONCURRENT_GENERATIONS=1
LLM_SYSTEM_PROMPT="You are a helpful, concise assistant in a Discord friends chat."
LOG_LEVEL=INFO
